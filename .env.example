# ============================================================================
# FinPay Database Environment Configuration
# Copy this file to .env before starting containers if custom values are needed:
# cp .env.example .env
# ============================================================================

# PostgreSQL Configuration (Portfolios 1, 2, 3, 5)
POSTGRES_DB=finpay_db
POSTGRES_USER=finpay_admin
POSTGRES_PASSWORD=FinPaySecure2026!
POSTGRES_PORT=5434

# PostgreSQL Connection Format (Host):
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# MongoDB Configuration (Portfolio 4)
MONGO_DB=finpay_nosql
MONGO_USER=finpay_mongo
MONGO_PASSWORD=FinPaySecure2026!
MONGO_PORT=27017

# MongoDB Connection Format (Host):
# mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:${MONGO_PORT}/${MONGO_DB}?authSource=admin
